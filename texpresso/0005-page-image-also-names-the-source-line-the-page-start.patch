 src/frontend/editor.h  |  3 +-
 src/frontend/main.c    |  9 +++++-
 src/frontend/synctex.c | 72 +++++++++++++++++++++++++++++++++++++++---
 src/frontend/synctex.h |  3 ++
 5 files changed, 98 insertions(+), 10 deletions(-)

